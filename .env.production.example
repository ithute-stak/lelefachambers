# Lelefa Chambers production environment
# Copy to .env on the VPS and replace every CHANGE_THIS_* value before startup.

APP_ENV=production

# Published application images
# Use latest for normal production pulls, or pin to sha-<shortsha> for rollback/reproducibility.
LELEFA_IMAGE_TAG=latest

# Shared-VPS loopback ports used by host Nginx.
# Container ports remain 8000 (API) and 3000 (web) internally.
LELEFA_API_HOST_PORT=18080
LELEFA_WEB_HOST_PORT=13000

# Database
POSTGRES_DB=lelefachambers
POSTGRES_USER=lelefa
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://lelefa:CHANGE_THIS_DATABASE_PASSWORD@db:5432/lelefachambers

# Redis / worker
REDIS_URL=redis://redis:6379/0
REMINDER_REDIS_STREAM=lelefa:chambers:reminders
AUTOMATION_SCAN_SECONDS=60

# Application security
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=https://lelefachambers.co.ls,https://www.lelefachambers.co.ls

# Bootstrap owner - use once, then rotate the account password from the application
BOOTSTRAP_ADMIN_EMAIL=info@lelefachambers.co.ls
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Lelefa Chambers System Administrator

# Lelefa Debt Collectors -> Chambers referral bridge
LELEFA_DEBT_COLLECTORS_API_KEY=CHANGE_THIS_DEBT_COLLECTORS_INTEGRATION_KEY

# Ithute Pay - remain disabled until a dedicated Chambers application is provisioned
ITHUTE_PAY_ENABLED=false
ITHUTE_PAY_BASE_URL=https://api.pay.ithute.co.ls/api/v1
ITHUTE_PAY_API_KEY=CHANGE_THIS_ITHUTE_PAY_APPLICATION_KEY
ITHUTE_PAY_SIGN_REQUESTS=true
ITHUTE_PAY_WEBHOOK_SECRET=CHANGE_THIS_ITHUTE_PAY_WEBHOOK_SECRET
ITHUTE_PAY_TIMEOUT_SECONDS=30

# Public production URLs
NEXT_PUBLIC_SITE_URL=https://lelefachambers.co.ls
# Browser API calls stay on the website origin and are proxied internally to the API container.
NEXT_PUBLIC_API_URL=https://lelefachambers.co.ls
SERVER_API_URL=http://api:8000

# Public CMS/media uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# Private legal-document vault
LEGAL_VAULT_DIR=/app/legal-vault
MAX_LEGAL_DOCUMENT_MB=25
