#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
cd "$ROOT_DIR"

MODE="${1:-latest}"
ENV_FILE="${ENV_FILE:-.env}"
REPO_SLUG="${LELEFA_GITHUB_REPOSITORY:-ithute-stak/lelefachambers}"
WORKFLOW_FILE="${LELEFA_RELEASE_WORKFLOW:-publish-images.yml}"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ROOT_DIR/$ENV_FILE" >&2
  exit 1
fi

resolve_latest_release_sha() {
  local api_url response sha
  api_url="https://api.github.com/repos/${REPO_SLUG}/actions/workflows/${WORKFLOW_FILE}/runs?branch=main&status=success&per_page=10"
  response="$(curl --fail --silent --show-error \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    "$api_url")"

  sha="$(printf '%s' "$response" | python3 -c '
import json, sys
payload = json.load(sys.stdin)
for run in payload.get("workflow_runs", []):
    if run.get("conclusion") == "success" and run.get("head_branch") == "main":
        sha = str(run.get("head_sha") or "").strip().lower()
        if len(sha) == 40 and all(c in "0123456789abcdef" for c in sha):
            print(sha)
            break
')"

  if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Could not resolve a successful published Chambers image release from GitHub Actions." >&2
    exit 1
  fi

  printf '%s' "$sha"
}

set_image_tag() {
  local sha="$1" tmp
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN

  if grep -q '^LELEFA_IMAGE_TAG=' "$ENV_FILE"; then
    sed "s/^LELEFA_IMAGE_TAG=.*/LELEFA_IMAGE_TAG=${sha}/" "$ENV_FILE" > "$tmp"
  else
    cat "$ENV_FILE" > "$tmp"
    printf '\nLELEFA_IMAGE_TAG=%s\n' "$sha" >> "$tmp"
  fi

  chmod --reference="$ENV_FILE" "$tmp" 2>/dev/null || true
  mv "$tmp" "$ENV_FILE"
  trap - RETURN
}

case "$MODE" in
  latest)
    echo "==> Resolving latest successful GitHub-published Chambers release"
    RELEASE_SHA="$(resolve_latest_release_sha)"
    ;;
  *)
    RELEASE_SHA="$(printf '%s' "$MODE" | tr '[:upper:]' '[:lower:]')"
    if [[ ! "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]; then
      echo "Usage: pull-chambers latest" >&2
      echo "   or: pull-chambers <full-40-character-release-sha>" >&2
      exit 1
    fi
    ;;
esac

echo "==> Selected immutable release: $RELEASE_SHA"
set_image_tag "$RELEASE_SHA"

# Keep deployment scripts/config in sync with main before using them. This does
# not build application images on the VPS; GitHub Actions remains the builder.
echo "==> Updating deployment code from main"
git fetch origin main
git merge --ff-only origin/main

# Re-apply the selected release in case the repository update changed templates.
set_image_tag "$RELEASE_SHA"

exec "$ROOT_DIR/scripts/deploy-images.sh"
