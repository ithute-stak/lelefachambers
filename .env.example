# Database
POSTGRES_DB=lelefachambers
POSTGRES_USER=lelefa
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://lelefa:CHANGE_THIS_DATABASE_PASSWORD@db:5432/lelefachambers

# Redis
REDIS_URL=redis://redis:6379/0
REMINDER_REDIS_STREAM=lelefa:chambers:reminders
AUTOMATION_SCAN_SECONDS=60

# API security
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:3000,https://lelefachambers.co.ls,https://www.lelefachambers.co.ls

# Bootstrap owner - rotate after first login
BOOTSTRAP_ADMIN_EMAIL=admin@lelefachambers.co.ls
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Lelefa Chambers Administrator

# Lelefa Debt Collectors -> Chambers referral bridge
# This shared key is only for server-to-server referral submission. Use a long random production secret.
LELEFA_DEBT_COLLECTORS_API_KEY=CHANGE_THIS_DEBT_COLLECTORS_INTEGRATION_KEY

# Ithute Pay consumer integration
# Keep disabled until Lelefa Chambers has its own Ithute Pay test application/API key and webhook endpoint.
ITHUTE_PAY_ENABLED=false
ITHUTE_PAY_BASE_URL=https://api.pay.ithute.co.ls/api/v1
ITHUTE_PAY_API_KEY=CHANGE_THIS_ITHUTE_PAY_APPLICATION_KEY
ITHUTE_PAY_SIGN_REQUESTS=true
ITHUTE_PAY_WEBHOOK_SECRET=CHANGE_THIS_ITHUTE_PAY_WEBHOOK_SECRET
ITHUTE_PAY_TIMEOUT_SECONDS=30

# Public / web
NEXT_PUBLIC_API_URL=http://localhost:8000
SERVER_API_URL=http://api:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public CMS/media uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# Private matter-document vault
# This path is not mounted as public static content. Downloads require authenticated API authorization.
LEGAL_VAULT_DIR=/app/legal-vault
MAX_LEGAL_DOCUMENT_MB=25
